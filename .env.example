# AIVORA local environment template.
#
# Copy this file to `.env.local` in the repository root and fill in your own values, or run:
#     powershell -NoProfile -ExecutionPolicy Bypass -File tools\set_dashscope_key.ps1
# which writes `.env.local` from a masked prompt.
#
# `.env` and `.env.*` are gitignored, so your real values can never be committed or
# published. This template is the only env file that is tracked, and it holds no values.
#
# The server loads `.env.local` first, then `.env`. A real environment variable always
# wins over a file value, so a hosting platform's injected env still takes precedence.

# --- Model Studio / Qwen (voice, Qwen4-Max text, omni analyze, ASR) ---
# Required for any live model call. Without it the app stays offline and model routes
# return 503 by design.
DASHSCOPE_API_KEY=
# Optional; the app defaults to ws-lj7gmtttiltwjlyv
WORKSPACE_ID=
# Optional; the app defaults to ap-southeast-1 (Singapore)
QWEN_REGION=
# Optional per-feature overrides
Q4_WORKSPACE_ID=
Q4_MODEL=
ASR_WORKSPACE_ID=

# --- Server ---
# Leave these OUT of .env.local. They change behaviour for every process that boots in this
# directory, including the test suite (which spawns servers and relies on the default
# non-memory mode to exercise the Supabase bearer guard). Set them per-run instead:
#   $env:PORT="8081"; $env:HOST="127.0.0.1"; $env:AIVORA_MEMORY_MODE="1"; node server.mjs
# PORT=8081
# HOST=127.0.0.1
# AIVORA_MEMORY_MODE=1

# --- Hashmeta storefront (optional; leave unset to stay in the labeled sandbox) ---
HASHMETA_API_TOKEN=
HASHMETA_MCP_URL=
HASHMETA_STORE_TOOL=

# --- Supabase (optional; all three or none) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_INSTANCE_ID=
# Server-side only. Never expose this to the browser or to an agent.
SUPABASE_SERVICE_ROLE_KEY=

# --- Appointment workflow (optional) ---
GOOGLE_CALENDAR_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to 1 to exercise dispatch in a clearly labeled sandbox (never claims "delivered").
WHATSAPP_SANDBOX=

# --- Mail (optional) ---
GMAIL_ACCESS_TOKEN=
# Set to 1 to exercise send in a clearly labeled sandbox.
GMAIL_SANDBOX=
